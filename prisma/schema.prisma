generator client {
  provider = "prisma-client"
  output   = "../src/infra/persistence/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Vaga {
  id         String   @id @default(uuid())
  codigo     String   @unique
  tipo       TipoVaga @default(PADRAO)
  disponivel Boolean  @default(true)
  tickets    Ticket[]

  @@map("vagas")
}

model Ticket {
  id String @id @default(uuid())
  codigo String @unique
  vagaId String
  status StatusTicket @default(PENDENTE)
  placa String
  tipoTarifa TipoTarifa @default(DIARIA)
  valorTarifa Int
  valorAdicionalTarifa Int
  valor Int
  criadoEm DateTime
  dataDeSaida DateTime?

  vaga Vaga @relation(fields: [vagaId], references: [id])

  @@map("tickets")
}

enum TipoVaga {
  PADRAO
  CADEIRANTE
  IDOSO
  MANUTENCAO
}

enum StatusTicket {
  PENDENTE
  PAGO
  CANCELADO
}

enum TipoTarifa {
  DIARIA
  MENSAL
  PRIMEIRA_HORA_MAIS_HORA_ADICIONAL
}